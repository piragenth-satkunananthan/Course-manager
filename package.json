{
  "name": "course-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild worker=src/worker/main.ts migrate=tools/migrate.ts create-student=tools/create-student.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --packages=external",
    "start:standalone": "cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/migrate.ts",
    "create-student": "tsx tools/create-student.ts",
    "spike:listen": "tsx spikes/m0/wa-listen.ts",
    "spike:messages": "tsx spikes/m0/dump-messages.ts",
    "spike:eval": "tsx spikes/m0/nim-eval.ts",
    "ai-eval": "tsx scripts/ai-eval.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.8",
    "baileys": "7.0.0-rc14",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
