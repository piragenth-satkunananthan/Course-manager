# Every variable the app and its scripts read. Copy to .env for local work; production lives in /opt/course-manager/.env (mode 600).

# Database. Compose builds the production DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/course_manager
DATABASE_URL_TEST=postgres://app:app@127.0.0.1:5432/course_manager_test
POSTGRES_PASSWORD=

# Auth. APP_HOST is Caddy's site address (the VM's FQDN); APP_ORIGIN and BETTER_AUTH_URL are https://<APP_HOST>.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
APP_HOST=
# Local end-to-end runs only: raises the sign-in limits. Ignored unless APP_ORIGIN is localhost.
RELAX_RATE_LIMITS=

# Encryption of WhatsApp keys and message text: 32 bytes, base64 (openssl rand -base64 32).
DATA_ENCRYPTION_KEY=

# NVIDIA NIM (#12)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=

# Email (#9)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_API_BASE_URL=https://api.resend.com

# healthchecks.io (#10)
HEALTHCHECK_REMINDERS_URL=
HEALTHCHECK_CAPTURE_URL=
HEALTHCHECK_BACKUP_URL=

# Backups: age public key, Blob container URL and SAS (#10)
BACKUP_AGE_RECIPIENT=
BACKUP_CONTAINER_URL=
BACKUP_SAS=

# Deploy: written by ops/deploy.sh. IMAGE_REPO overrides the GHCR image prefix.
IMAGE_TAG=
IMAGE_REPO=

# M0 spikes only
AI_EVAL_DIR=
